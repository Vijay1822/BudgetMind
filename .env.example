NODE_ENV=development
PORT=3001

# PostgreSQL / Supabase Configuration
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hindsight Long-Term Memory Service
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=budgetmind-procurement-bank

# Configurable LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Firebase Authentication (Frontend Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Frontend API URL (leave empty in local dev to use Vite proxy)
VITE_API_URL=